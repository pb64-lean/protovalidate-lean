# protovalidate-lean/MODULE.bazel
"""Bazel module for protovalidate support in pure Lean.

Consumes and extends rules_lean (base Lean build rules) and rules_lean_grpc
(Lean proto/gRPC codegen) with protovalidate rules and a Lean runtime:

    bazel_dep(name = "protovalidate_lean", version = "0.1.0")
    load("@protovalidate_lean//protovalidate:defs.bzl", ...)
"""

module(
    name = "protovalidate_lean",
    version = "0.1.0",
    compatibility_level = 1,
)

# Base Lean build rules. local_path_override is honored only when
# protovalidate_lean is the root module; downstream consumers supply their own
# overrides (or the registry resolves these).
bazel_dep(name = "rules_lean", version = "0.1.0")
local_path_override(
    module_name = "rules_lean",
    path = "../rules_lean",
)

# Lean proto/gRPC codegen rules (lean_proto_library etc.).
bazel_dep(name = "rules_lean_grpc", version = "0.1.0")
local_path_override(
    module_name = "rules_lean_grpc",
    path = "../grpc-lean",
)

# rules_lean_grpc's own overrides only apply when it is the root module, so we
# re-declare its local module dependencies here.
bazel_dep(name = "grpc_lean_protobuf", version = "0.1.0")
local_path_override(
    module_name = "grpc_lean_protobuf",
    path = "../grpc-lean/third_party/Lean-zh/protobuf",
)

bazel_dep(name = "grpc_lean_protobuf_binary", version = "0.1.0")
local_path_override(
    module_name = "grpc_lean_protobuf_binary",
    path = "../grpc-lean/third_party/Lean-zh/binary",
)

# Proto codegen dependencies.
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4")

# buf.validate proto definitions (validate.proto) for annotated protos.
bazel_dep(name = "protovalidate", version = "1.2.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# Go toolchain for the cel2lean translator (CEL → Lean propositions). Go is a
# codegen-time dependency only: it hosts the official cel-go parser, the
# correctness anchor for CEL syntax (escapes, precedence, macros).
bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.5")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go", "com_github_google_cel_go", "org_golang_google_protobuf")

# Lean toolchain for protovalidate_lean's OWN builds/tests only (dev_dependency,
# so it is not forced on consumers). Reuses the pinned nixpkgs + lean overlay
# from grpc_lean_protobuf, matching the grpc-lean setup.
lean = use_extension("@rules_lean//lean:extensions.bzl", "lean", dev_dependency = True)
lean.nix_toolchain(
    name = "lean4",
    attr = "lean4_upstream_std",
    nix_file = "@grpc_lean_protobuf//:nixpkgs.nix",
    nix_file_deps = ["@grpc_lean_protobuf//:nixpkgs.json"],
)
use_repo(lean, "lean4_toolchain")

register_toolchains(
    "@lean4_toolchain//:all",
    dev_dependency = True,
)
